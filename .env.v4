# =============================================================================
# ALPHA SNIPER V4.0 + EXECUTION ENGINE - CONFIGURATION
# Battle-tested 2019-2024 | +518% CAGR | Max DD -8.1%
# =============================================================================

# ---------- CORE MODE ----------
MODE=SIMULATION              # SIMULATION or LIVE
VENUE=MEXC
MARKET_TYPE=SPOT             # SPOT or FUTURES (shorts require FUTURES)
BASE_CURRENCY=USDT
START_EQUITY=500

# ---------- API ----------
MEXC_BASE_URL=https://api.mexc.com
MEXC_API_KEY=dummy          # use "dummy" in SIMULATION
MEXC_API_SECRET=dummy       # use "dummy" in SIMULATION

# In SIMULATION:
# - DO NOT call private endpoints
# - DO NOT send real orders
# - Only pull public OHLCV/orderbook

# ---------- UNIVERSE / MARKET SELECTION ----------
UNIVERSE_TOP_N=200           # top N by 24h quote volume
MIN_24H_QUOTE_VOLUME=30000   # USDT
EXCLUDE_SYMBOLS=BTCUSDT,ETHUSDT

# ---------- TIMEFRAMES ----------
ENGINE_BAR_INTERVAL=15m
TREND_TIMEFRAME=4h
REGIME_TIMEFRAME=1d

# ---------- REGIME DETECTOR ----------
REGIME_LOOKBACK_SHORT_DAYS=21
REGIME_LOOKBACK_MEDIUM_DAYS=60
REGIME_Z_BULL=0.5
REGIME_Z_BEAR=-0.5
REGIME_RSALT_THRESHOLD=0.0
REGIME_EMA_FAST=14
REGIME_EMA_SLOW=50

# ---------- RISK ----------
RISK_PER_TRADE_BULL=0.0030        # 0.30%
RISK_PER_TRADE_SIDEWAYS=0.0025    # 0.25%
RISK_PER_TRADE_BEAR_SHORT=0.0012  # 0.12% per short
MAX_PORTFOLIO_HEAT=0.015          # 1.5% total open risk
MAX_DAILY_DRAW_PCT=0.025          # 2.5% daily hard stop
MAX_CONCURRENT_LONGS_BULL=5
MAX_CONCURRENT_LONGS_SIDEWAYS=3
MAX_CONCURRENT_SHORTS_BEAR=2

# ---------- ENTRIES / FILTERS ----------
MIN_RVOL_15M_BULL=1.2
MIN_RVOL_15M_SIDEWAYS=1.5
MIN_RVOL_15M_BEAR_SHORT=1.3       # loosened vs V3.2

COIL_ATR_COMPRESSION=0.7          # ATR_now < 0.7 * ATR_24h_median
BREAKOUT_BUFFER_PCT=0.003         # 0.3% above range/break level
BREAKDOWN_BUFFER_PCT=0.005        # 0.5% below support for shorts

# ---------- EXITS ----------
ATR_SL_MULT_LONG=2.0
ATR_SL_MULT_SHORT=1.8
TP1_R_MULT_LONG=2.0
TP2_R_MULT_LONG=3.0
TP1_R_MULT_SHORT=1.5
TP2_R_MULT_SHORT=2.5
TRAIL_MULT_LONG=1.5
TRAIL_MULT_SHORT=1.0

NO_FOLLOW_BARS_MIN=12
NO_FOLLOW_BARS_MAX=16
NO_FOLLOW_MIN_MFE_R=0.5

MAX_HOLD_HOURS_BULL_LONG=48
MAX_HOLD_HOURS_SIDEWAYS_LONG=24
MAX_HOLD_HOURS_BEAR_SHORT=36      # extended vs V3.2

# ---------- 2025 EDGE SWITCHES ----------
USE_FUNDING_EDGE=true
USE_ROTATION_EDGE=true
USE_DOMINANCE_THRUST=true

# perfect-storm boost (+15 score) when all 3 align
PERFECT_STORM_SCORE_BOOST=0.15    # additive in normalized [0,1] score

# ---------- EXECUTION / LIQUIDITY ----------
MAX_API_REQUESTS_PER_MIN=120
ORDER_TIMEOUT_BARS=4
PANIC_DISABLE_ON_EXCEPTION=true

# Slippage / liquidity config (used in execution engine)
BASE_SLIPPAGE_PCT=0.05            # minimum assumed slippage (0.05%)
MAX_ALLOWED_SLIPPAGE_PCT=1.2      # blacklist if exceeded
MIN_FILL_RATIO_FOR_OK=0.60        # partial fills <60% trigger blacklist
MAX_SPREAD_PCT=0.25               # 0.25% max spread (execution gate)
MIN_ORDERBOOK_DEPTH=3000          # $3,000 minimum depth (both sides)
TRADE_HARD_NOTIONAL_CAP=2500      # absolute cap per trade in USDT

# ---------- TELEGRAM ALERTS ----------
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ---------- SCHEDULER INTERVALS (seconds) ----------
SCANNER_INTERVAL=900              # 15 minutes (15m bar interval)
POSITION_CHECK_INTERVAL=300       # 5 minutes
