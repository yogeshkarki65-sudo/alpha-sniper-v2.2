# MEXC API Configuration
MEXC_BASE_URL=https://api.mexc.com
VENUE=MEXC

# Trading Mode
MODE=SIM
SIM_EQUITY_START=500
LIVE_EQUITY_START=0

# BUG FIX: SIM Regime Behavior (BUG C)
# By default, SIM respects regime rules (same as LIVE)
# Set to 'true' to override and trade in ALL regimes (RISKY!)
SIM_IGNORE_REGIME=false

# Risk Management (CRITICAL)
MAX_DAILY_DRAWDOWN_PCT=2.0
MAX_POSITION_RISK_PCT=0.5
MIN_LIQUIDITY_VOLUME_24H=100000
MAX_CORRELATED_POSITIONS=2
TRADING_PAUSED=false

# V4.1.1: R-based Position Sizing (% of equity to RISK per trade)
# Position size = (equity * risk_pct) / stop_distance_pct
RISK_PER_TRADE_BULL=0.003
RISK_PER_TRADE_SIDEWAYS=0.0025
RISK_PER_TRADE_BEAR_SHORT=0.0012
RISK_PER_TRADE_BEAR_LONG=0.0008
MAX_PORTFOLIO_HEAT=0.015
MAX_CONCURRENT_POSITIONS=5

# Position Management (legacy - use R-based sizing above)
MAX_CONCURRENT_POS=2
MAX_PER_TRADE_PCT=20.0
STOP_LOSS_PCT=5.0
TAKE_PROFIT_PCT=10.0

# Exit Strategy
USE_TRAILING_STOP=true
TRAILING_STOP_ACTIVATION_PCT=2.0
TRAILING_STOP_DISTANCE_PCT=1.0
MAX_HOLD_TIME_HOURS=24

# Fees & Slippage
MAKER_FEE_PCT=0.0
TAKER_FEE_PCT=0.1
SLIPPAGE_PCT=0.05

# Signal Configuration
MIN_SIGNAL_SCORE=80
SYMBOL_COOLDOWN_HOURS=6
CHECK_ORDER_BOOK_IMBALANCE=true
MOON_SCORE=90
MOON_MULT=1.5

# V4.1.1 Tuned Parameters (2017-2025 Backtest)
# Bull/Sideways RVOL threshold for longs
MIN_RVOL_15M_BULL=1.15
# Trend ratio cutoff for uptrend check (EMA20/EMA50 on 4h)
TREND_RATIO_4H_CUTOFF=1.008
# ATR stop loss multiple for longs (1.9 × ATR)
ATR_SL_MULT_LONG=1.9
# Perfect storm score boost (when funding + rotation + dominance align)
PERFECT_STORM_SCORE_BOOST=0.17
# Maximum allowed spread for any trade
MAX_ALLOWED_SPREAD_PCT=1.1
# Bear short RVOL threshold
MIN_RVOL_15M_BEAR_SHORT=1.25

# Self-Learning
LEARNING_ENABLED=true
MIN_TRADES_FOR_LEARNING=30
MAX_WEIGHT_CHANGE_PCT=15
LEARNING_LOOKBACK_DAYS=30

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ALERT_ON_DRAWDOWN_PCT=3.0
ALERT_ON_WEIGHT_CHANGE_PCT=10.0
DAILY_REPORT_HOUR=9

# Scheduler Intervals (seconds)
SCANNER_INTERVAL=300
TRADER_INTERVAL=60
LEARNING_INTERVAL=3600

# Bear-Resilient Long Engine (NEW FEATURE)
# Ultra-conservative micro long engine for BEAR regime only
# Designed to catch 50-150% pumps during bear markets
ENABLE_BEAR_LONGS=true
RISK_PER_TRADE_BEAR_LONG=0.0008
MAX_CONCURRENT_BEAR_LONGS=1
MAX_HOLD_HOURS_BEAR_LONG=24

# Bear-Resilient Long Filters
MIN_RVOL_15M_BEAR_LONG=1.5
MIN_24H_RETURN_BEAR_LONG=0.05
MAX_24H_RETURN_BEAR_LONG=0.40
MIN_DEPTH_10K_BEAR_LONG=10000
MAX_SPREAD_PCT_BEAR_LONG=1.0
