# ============================================================================
# ALPHA SNIPER V4.2_FULL_DYNAMIC - 4-REGIME SYSTEM
# ============================================================================
#
# V4.2_FULL_DYNAMIC: Granular 4-regime system with per-regime risk sizing
#   - BULL: Full longs, 0.25% R per trade
#   - SIDEWAYS: Longs + shorts, 0.25% R per trade
#   - MILD_BEAR: Bear-resilient longs + shorts, 0.18% R per trade
#   - DEEP_BEAR: Minimal longs + shorts, 0.15% R per trade
#
# RISK PROFILE PRESETS (choose one):
#   SAFE       - Conservative: 0.15% R per trade, no shorts, pump 15-25%
#   MODERATE   - Balanced: 0.25% R per trade, shorts in SIDEWAYS+BEAR, pump 20-35%
#   AGGRESSIVE - High risk: 0.35% R per trade, full shorts, pump 25-40%
#
# Recommended preset (MODERATE) based on 2016-2025 backtest:
#   - ROI: +4,616% ($500 -> $23,580)
#   - Win Rate: 60.9%
#   - Profit Factor: 2.24
#   - Max Drawdown: -9.5%
#   - Worst Loss: -2.8R
#
# ============================================================================

# RISK PROFILE (SAFE / MODERATE / AGGRESSIVE)
# This sets sensible defaults; individual params below can override
RISK_PROFILE=MODERATE

# ============================================================================
# MEXC API Configuration
# ============================================================================
MEXC_BASE_URL=https://api.mexc.com
VENUE=MEXC

# ============================================================================
# Trading Mode
# ============================================================================
MODE=SIM
SIM_EQUITY_START=500
LIVE_EQUITY_START=0
MARKET_TYPE=SPOT

# BUG FIX: SIM Regime Behavior (BUG C)
# By default, SIM respects regime rules (same as LIVE)
SIM_IGNORE_REGIME=false

# ============================================================================
# FUTURES & SHORTS CONFIGURATION (V4.2_FULL_DYNAMIC: 4-Regime)
# ============================================================================
# Enable futures trading (required for shorts)
ENABLE_FUTURES=true

# V4.2_FULL_DYNAMIC: Per-regime shorts settings
# IMPORTANT: ENABLE_SHORTS_IN_BULL=false recommended (negative EV in bull regime)
ENABLE_SHORTS_IN_BULL=false
ENABLE_SHORTS_IN_SIDEWAYS=true
ENABLE_SHORTS_IN_MILD_BEAR=true
ENABLE_SHORTS_IN_DEEP_BEAR=true

# Funding rate filter for shorts (skip if 8h funding > this value)
# 0.00035 = 0.035% per 8h (prevents shorting when funding is too negative)
MAX_FUNDING_8H_SHORT=0.00035

# ============================================================================
# CORE RISK PARAMETERS (V4.2_FULL_DYNAMIC: 4-Regime)
# ============================================================================
# R-based Position Sizing: size = (equity * risk_pct) / stop_distance_pct
#
# V4.2_FULL_DYNAMIC: Per-regime risk sizing
#   SAFE preset:     BULL=0.15%, SIDEWAYS=0.15%, MILD_BEAR=0.12%, DEEP_BEAR=0.10%
#   MODERATE preset: BULL=0.25%, SIDEWAYS=0.25%, MILD_BEAR=0.18%, DEEP_BEAR=0.15%
#   AGGRESSIVE:      BULL=0.35%, SIDEWAYS=0.35%, MILD_BEAR=0.25%, DEEP_BEAR=0.20%

# Standard long risk per regime
RISK_PER_TRADE_BULL=0.0025
RISK_PER_TRADE_SIDEWAYS=0.0025
RISK_PER_TRADE_MILD_BEAR=0.0018
RISK_PER_TRADE_DEEP_BEAR=0.0015

# Short risk per regime (used when shorts enabled)
RISK_PER_TRADE_SIDEWAYS_SHORT=0.0015
RISK_PER_TRADE_MILD_BEAR_SHORT=0.0015
RISK_PER_TRADE_DEEP_BEAR_SHORT=0.0012

# Bear-resilient micro-long risk (MILD_BEAR + DEEP_BEAR only)
RISK_PER_TRADE_BEAR_LONG=0.0010

# Portfolio heat = sum of all open R / equity (max total risk exposure)
MAX_PORTFOLIO_HEAT=0.015
MAX_CONCURRENT_POSITIONS=5

# ============================================================================
# SIGNAL THRESHOLDS (Tuned from 2016-2025 Backtest)
# ============================================================================
# Minimum score to consider any signal
MIN_SIGNAL_SCORE=80

# Bull/Sideways Long Thresholds
MIN_RVOL_15M_BULL=1.15
TREND_RATIO_4H_CUTOFF=1.008
ATR_SL_MULT_LONG=1.9
PERFECT_STORM_SCORE_BOOST=0.17
MAX_ALLOWED_SPREAD_PCT=1.1

# Bear Short Thresholds
MIN_RVOL_15M_BEAR_SHORT=1.25

# ============================================================================
# RISK MANAGEMENT
# ============================================================================
MAX_DAILY_DRAWDOWN_PCT=2.0
MAX_POSITION_RISK_PCT=0.5
MIN_LIQUIDITY_VOLUME_24H=100000
MAX_CORRELATED_POSITIONS=2
TRADING_PAUSED=false

# ============================================================================
# EXIT STRATEGY
# ============================================================================
USE_TRAILING_STOP=true
TRAILING_STOP_ACTIVATION_PCT=2.0
TRAILING_STOP_DISTANCE_PCT=1.0
MAX_HOLD_TIME_HOURS=24

# ============================================================================
# FEES & SLIPPAGE
# ============================================================================
MAKER_FEE_PCT=0.0
TAKER_FEE_PCT=0.1
SLIPPAGE_PCT=0.05

# ============================================================================
# SIGNAL CONFIGURATION
# ============================================================================
SYMBOL_COOLDOWN_HOURS=6
CHECK_ORDER_BOOK_IMBALANCE=true
MOON_SCORE=90
MOON_MULT=1.5

# ============================================================================
# SELF-LEARNING
# ============================================================================
LEARNING_ENABLED=true
MIN_TRADES_FOR_LEARNING=30
MAX_WEIGHT_CHANGE_PCT=15
LEARNING_LOOKBACK_DAYS=30

# ============================================================================
# TELEGRAM ALERTS
# ============================================================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ALERT_ON_DRAWDOWN_PCT=3.0
ALERT_ON_WEIGHT_CHANGE_PCT=10.0
DAILY_REPORT_HOUR=9

# ============================================================================
# SCHEDULER INTERVALS (seconds)
# ============================================================================
SCANNER_INTERVAL=300
TRADER_INTERVAL=60
LEARNING_INTERVAL=3600

# ============================================================================
# BEAR-RESILIENT LONG ENGINE (V4.2_FULL_DYNAMIC)
# ============================================================================
# Ultra-conservative micro long engine for MILD_BEAR + DEEP_BEAR regimes
# Designed to catch 50-150% pumps during bear markets
# Triggers automatically when regime is MILD_BEAR or DEEP_BEAR
ENABLE_BEAR_LONGS=true
MAX_CONCURRENT_BEAR_LONGS=1
MAX_HOLD_HOURS_BEAR_LONG=24

# Bear-Resilient Long Filters
MIN_RVOL_15M_BEAR_LONG=1.5
MIN_24H_RETURN_BEAR_LONG=0.05
MAX_24H_RETURN_BEAR_LONG=0.40
MIN_DEPTH_10K_BEAR_LONG=10000
MAX_SPREAD_PCT_BEAR_LONG=1.0

# ============================================================================
# V4.2_FULL_DYNAMIC: NEW TOKEN PUMP CATCHER ENGINE
# ============================================================================
# Catches early pumps on newly listed tokens (3-48h old)
# Uses DYNAMIC 20-35% equity allocation based on pump activity
#
# Dynamic Allocation Logic:
#   - Tracks last PUMP_WR_LOOKBACK pump trades
#   - If avg R > 0 AND avg candidates per scan >= PUMP_HOT_MARKET_THRESHOLD:
#     -> Use PUMP_ALLOC_MAX (35%)
#   - Else:
#     -> Use PUMP_ALLOC_MIN (20%)
#   - Always respects MAX_PORTFOLIO_HEAT cap
#
# SAFE preset:       ALLOC 15-25%, RISK 0.0008
# MODERATE preset:   ALLOC 20-35%, RISK 0.0010
# AGGRESSIVE preset: ALLOC 25-40%, RISK 0.0012

# Enable/Disable
ENABLE_PUMP_ENGINE=true

# Allocation / Capital Slice (dynamic range)
PUMP_ALLOC_MIN=0.20
PUMP_ALLOC_MAX=0.35
PUMP_RISK_PER_TRADE=0.0010
PUMP_MAX_CONCURRENT=2

# New Token Filters
PUMP_MIN_AGE_HOURS=3
PUMP_MAX_AGE_HOURS=48
PUMP_MIN_VOLUME_USDT=50000
PUMP_MIN_RVOL_15M=2.0
PUMP_MIN_1H_MOMENTUM=0.25
PUMP_MIN_24H_RETURN=0.30
PUMP_MAX_24H_RETURN=4.0
PUMP_MAX_SPREAD_PCT=1.5
PUMP_MIN_DEPTH_10K=5000

# Exit Rules
PUMP_ATR_SL_MULT=1.5
PUMP_MAX_HOLD_HOURS=6

# Engine Health / Throttle (for dynamic allocation)
# PUMP_WR_LOOKBACK: Number of recent pump trades to track
# PUMP_WR_MIN: Minimum win rate before engine pauses (40%)
# PUMP_HOT_MARKET_THRESHOLD: Min candidates per scan for "hot market" -> max alloc
PUMP_WR_LOOKBACK=20
PUMP_WR_MIN=0.40
PUMP_HOT_MARKET_THRESHOLD=5
