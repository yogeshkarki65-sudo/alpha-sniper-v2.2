######################################################################
#              ALPHA SNIPER V2.3 – OPTIMIZED CONFIGURATION
#         Tuned for better signal generation and SIM testing
######################################################################

# ============================================
# MEXC API CONFIGURATION
# ============================================
MEXC_BASE_URL=https://api.mexc.com
VENUE=MEXC

# ============================================
# TRADING MODE
# ============================================
# Options: SIM or LIVE
# ALWAYS start with SIM mode for at least 7-14 days!
MODE=SIM

# Starting equity for simulation mode
SIM_EQUITY_START=500

# Starting equity for live mode (only used when MODE=LIVE)
LIVE_EQUITY_START=0

# ============================================
# RISK MANAGEMENT (CRITICAL!)
# ============================================
# Maximum daily drawdown percentage before pausing trading
MAX_DAILY_DRAWDOWN_PCT=2.0

# Maximum risk per position as percentage of equity
# V2.3: Increased from 0.5% to 1.0% for more data in SIM
MAX_POSITION_RISK_PCT=1.0

# Minimum 24h volume required for a coin (in USD)
# V2.3: Reduced from 100k to 50k to capture more opportunities
MIN_LIQUIDITY_VOLUME_24H=50000

# Maximum number of correlated positions allowed
MAX_CORRELATED_POSITIONS=2

# Emergency pause trading (set to true to stop all trading)
TRADING_PAUSED=false

# ============================================
# POSITION MANAGEMENT
# ============================================
# Maximum number of concurrent positions
# V2.3: Increased from 2 to 3 for better portfolio diversification
MAX_CONCURRENT_POS=3

# Maximum percentage of equity per trade
# V2.3: Increased from 20% to 25%
MAX_PER_TRADE_PCT=25.0

# Stop loss percentage
STOP_LOSS_PCT=5.0

# Take profit percentage
# V2.3: Increased from 10% to 12% for better R:R
TAKE_PROFIT_PCT=12.0

# ============================================
# EXIT STRATEGY
# ============================================
# Enable/disable trailing stop
USE_TRAILING_STOP=true

# Profit percentage needed to activate trailing stop
# V2.3: Increased from 2% to 4% to avoid premature activation
TRAILING_STOP_ACTIVATION_PCT=4.0

# Distance of trailing stop from highest price
# V2.3: Increased from 1% to 2% to reduce whipsaw exits
TRAILING_STOP_DISTANCE_PCT=2.0

# Maximum time to hold a position (in hours)
MAX_HOLD_TIME_HOURS=24

# ============================================
# FEES & SLIPPAGE
# ============================================
# Maker fee percentage
MAKER_FEE_PCT=0.0

# Taker fee percentage (MEXC default)
TAKER_FEE_PCT=0.1

# Expected slippage percentage
SLIPPAGE_PCT=0.05

# ============================================
# SIGNAL CONFIGURATION
# ============================================
# Minimum signal score to consider a trade (0-100)
# V2.3: Reduced from 70 to 60 to generate more signals
MIN_SIGNAL_SCORE=60

# Cooldown period for the same symbol (in hours)
# V2.3: Reduced from 6h to 3h for faster re-entry
SYMBOL_COOLDOWN_HOURS=3

# Check order book imbalance before trading
# V2.3: Disabled temporarily to reduce API calls and complexity
CHECK_ORDER_BOOK_IMBALANCE=false

# "Moon shot" signal threshold
# V2.3: Reduced from 90 to 85
MOON_SCORE=85

# Position size multiplier for moon shots
MOON_MULT=1.5

# ============================================
# SELF-LEARNING MODULE
# ============================================
# Enable/disable self-learning
LEARNING_ENABLED=true

# Minimum trades required before learning starts
# V2.3: Reduced from 30 to 20 for faster learning activation
MIN_TRADES_FOR_LEARNING=20

# Maximum weight change per learning iteration (%)
MAX_WEIGHT_CHANGE_PCT=15

# Days of historical data to use for learning
# V2.3: Reduced from 30 to 20 days for more responsive learning
LEARNING_LOOKBACK_DAYS=20

# ============================================
# TELEGRAM ALERTS (REQUIRED!)
# ============================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Alert when drawdown exceeds this percentage
ALERT_ON_DRAWDOWN_PCT=3.0

# Alert when learning changes weights by this much
ALERT_ON_WEIGHT_CHANGE_PCT=10.0

# Hour of day (0-23 UTC) to send daily report
DAILY_REPORT_HOUR=9

# ============================================
# SCHEDULER INTERVALS (in seconds)
# ============================================
# How often to scan for new opportunities
SCANNER_INTERVAL=300

# How often to check and execute trades
TRADER_INTERVAL=60

# How often to run self-learning
# V2.3: Reduced from 3600 to 1800 (every 30 min)
LEARNING_INTERVAL=1800

######################################################################
# V2.3 CHANGES SUMMARY
######################################################################
#
# Scanner Improvements:
# - MIN_SIGNAL_SCORE: 70 → 60 (more signals)
# - MIN_LIQUIDITY_VOLUME_24H: 100k → 50k (more opportunities)
# - CHECK_ORDER_BOOK_IMBALANCE: true → false (simpler, fewer API calls)
# - SYMBOL_COOLDOWN_HOURS: 6 → 3 (faster re-entry)
# - MOON_SCORE: 90 → 85 (more high-confidence trades)
#
# Risk Management:
# - MAX_POSITION_RISK_PCT: 0.5% → 1.0% (more data for SIM)
# - MAX_CONCURRENT_POS: 2 → 3 (better diversification)
# - MAX_PER_TRADE_PCT: 20% → 25% (slightly more aggressive)
#
# Exit Strategy:
# - TAKE_PROFIT_PCT: 10% → 12% (better reward:risk)
# - TRAILING_STOP_ACTIVATION_PCT: 2% → 4% (less premature)
# - TRAILING_STOP_DISTANCE_PCT: 1% → 2% (less whipsaw)
#
# Learning Module:
# - MIN_TRADES_FOR_LEARNING: 30 → 20 (faster activation)
# - LEARNING_LOOKBACK_DAYS: 30 → 20 (more responsive)
# - LEARNING_INTERVAL: 3600s → 1800s (runs every 30 min)
#
# Expected Results:
# - 5-15 signals per scanner run (was 0)
# - 3-10 trades per day (was 0)
# - Learning module active after ~1 week
# - Better data for optimization
######################################################################
