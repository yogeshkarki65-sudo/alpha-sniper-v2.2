# MEXC API Configuration
MEXC_BASE_URL=https://api.mexc.com
VENUE=MEXC

# Trading Mode
MODE=SIM
SIM_EQUITY_START=500
LIVE_EQUITY_START=0

# Risk Management (CRITICAL - v4.1.1)
MAX_DAILY_DRAWDOWN_PCT=15.0
MAX_POSITION_RISK_PCT=0.5
MIN_LIQUIDITY_VOLUME_24H=100000
MAX_CORRELATED_POSITIONS=2
TRADING_PAUSED=false

# Position Management (v4.1.1)
MAX_CONCURRENT_POSITIONS=3
MAX_PER_TRADE_PCT=20.0
RISK_PER_TRADE_PCT=3.0
STOP_LOSS_PCT=3.0
TAKE_PROFIT_PCT=10.0

# Exit Strategy (v4.1.1)
USE_TRAILING_STOP=true
TRAILING_ACTIVATION_PCT=4.0
TRAILING_DISTANCE_PCT=1.5
BREAKEVEN_AFTER_PCT=5.0
MAX_HOLD_TIME_HOURS=24

# Fees & Slippage
MAKER_FEE_PCT=0.0
TAKER_FEE_PCT=0.1
SLIPPAGE_PCT=0.05

# Signal Configuration (v4.1.1)
MIN_SIGNAL_SCORE=65
MIN_RSI_1H=60
MAX_RSI_1H=75
MIN_RVOL_1H=2.0
SYMBOL_COOLDOWN_HOURS=12
CHECK_ORDER_BOOK_IMBALANCE=true
MOON_SCORE=75
MOON_MULT=2.0

# Entry Quality Filters (v4.1.1)
REJECT_PARABOLIC_MOVES=true
PARABOLIC_THRESHOLD=1.5
REJECT_HIGH_RANGE_ENTRIES=true
MAX_RANGE_POSITION_PCT=0.85
PREFER_PULLBACKS=true

# Self-Learning
LEARNING_ENABLED=true
MIN_TRADES_FOR_LEARNING=30
MAX_WEIGHT_CHANGE_PCT=15
LEARNING_LOOKBACK_DAYS=30

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
ALERT_ON_DRAWDOWN_PCT=10.0
ALERT_ON_WEIGHT_CHANGE_PCT=10.0
DAILY_REPORT_HOUR=9

# Scheduler Intervals (seconds)
SCANNER_INTERVAL=300
TRADER_INTERVAL=60
LEARNING_INTERVAL=3600
