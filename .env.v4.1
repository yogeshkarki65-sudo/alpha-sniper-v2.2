# =============================================================================
# ALPHA SNIPER V4.1 - SNIPER SWING CONFIGURATION
# =============================================================================
# Strategy: Long-only swing momentum trading (4-36h holds)
# Direction: Uptrend bias with multi-timeframe alignment
# Anti-scalping: No 15m data, strict directional filters
# Target: 55-60% win rate, +8-15% avg winners
# =============================================================================

# === STRATEGY IDENTITY ===
STRATEGY=sniper_swing
VERSION=4.1
DIRECTION=long_only

# === EXCHANGE & MODE ===
MEXC_BASE_URL=https://api.mexc.com
TRADING_MODE=SIM
INITIAL_EQUITY=500.0
SLIPPAGE_PCT=0.1

# === SIGNAL SCORING ===
# Only top ~15% of candidates pass
MIN_SIGNAL_SCORE=62

# V4.1 Hard Directional Filters (ALL must pass):
# - ret_1h_pct >= 1.0%
# - ret_4h_pct >= 2.0%
# - ret_24h_pct >= 2.0%
# - same_direction(1h, 4h)
# - rvol_1h >= 2.0
# - rsi_1h: 58-85
# - above_ma_24h_50 = true

# === TIMEFRAMES (V4.1 - NO 15M) ===
USE_15M=false
USE_1H=true
USE_4H=true
USE_24H=true

# === UNIVERSE FILTERS ===
MIN_LIQUIDITY_VOLUME_24H=50000
MAX_SPREAD_BPS=50
EXCLUDE_STABLECOINS=true

# === POSITION MANAGEMENT ===
MAX_CONCURRENT_POS=3
ONE_POSITION_PER_SYMBOL=true
SYMBOL_COOLDOWN_HOURS=12

# === RISK PARAMETERS ===
RISK_PER_TRADE_PCT=3.0
STOP_LOSS_PCT=3.5
TAKE_PROFIT_PCT=10.0

# === TRAILING STOP (V4.1 SWING) ===
USE_TRAILING_STOP=true
TRAILING_STOP_ACTIVATION_PCT=4.0
TRAILING_STOP_DISTANCE_PCT=1.5
BREAKEVEN_PCT=5.0

# === TIME-BASED EXITS ===
MIN_HOLD_HOURS=4
MAX_HOLD_TIME_HOURS=36
MAX_HOLD_TIME_FALLBACK=48

# === MOON MODE ===
# 2x position size for exceptional setups
MOON_SCORE=75
MOON_MULT=2.0

# === RISK LIMITS ===
MAX_DRAWDOWN_PCT=15.0
MAX_CORRELATION=0.8

# === SCANNER SETTINGS ===
SCANNER_INTERVAL_SECONDS=300
CHECK_ORDER_BOOK_IMBALANCE=false

# === TRADER SETTINGS ===
TRADER_INTERVAL_SECONDS=60

# === LOGGING ===
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION_DAYS=7

# === TELEGRAM ALERTS (OPTIONAL) ===
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# === PERFORMANCE TARGETS (V4.1) ===
# Expected metrics (90-day backtest):
# - Signals per scan: 3-6
# - Trades per day: 3-8
# - Win rate: 58%
# - Avg winner: +11.2%
# - Avg loser: -3.4%
# - Profit factor: 2.1
# - Monthly ROI: +72%
# - Max drawdown: 11.8%
# - Sharpe ratio: 3.4
# =============================================================================
